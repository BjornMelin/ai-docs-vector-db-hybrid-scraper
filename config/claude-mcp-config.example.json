{
  "mcpServers": {
    "ai-docs-vector-db-unified": {
      "command": "uv",
      "args": ["run", "python", "src/unified_mcp_server.py"],
      "cwd": "/path/to/ai-docs-vector-db-hybrid-scraper",
      "env": {
        "FASTMCP_TRANSPORT": "stdio",
        "AI_DOCS_EMBEDDING_PROVIDER": "fastembed",
        "AI_DOCS_CRAWL_PROVIDER": "crawl4ai",
        "AI_DOCS_QDRANT__URL": "http://localhost:6333"
      }
    }
  }
}
