# AI Docs local configuration
#
# Pydantic uses the AI_DOCS_ prefix. Separate nested model fields with a
# double underscore: AI_DOCS_QDRANT__URL.

# Application
AI_DOCS_MODE=simple
AI_DOCS_ENVIRONMENT=development
AI_DOCS_DEBUG=false
AI_DOCS_LOG_LEVEL=INFO

# Providers
AI_DOCS_EMBEDDING_PROVIDER=fastembed
AI_DOCS_CRAWL_PROVIDER=crawl4ai

# Qdrant
AI_DOCS_QDRANT__URL=http://localhost:6333
AI_DOCS_QDRANT__COLLECTION_NAME=documents
AI_DOCS_QDRANT__USE_GRPC=false
AI_DOCS_QDRANT__API_KEY=

# Optional cloud providers
# Required only when the corresponding provider or feature is enabled.
AI_DOCS_OPENAI__API_KEY=
AI_DOCS_BROWSER__FIRECRAWL__API_KEY=

# Local cache
AI_DOCS_CACHE__ENABLE_CACHING=true
AI_DOCS_CACHE__ENABLE_DRAGONFLY_CACHE=false
AI_DOCS_CACHE__DRAGONFLY_URL=redis://localhost:6379

# Retrieval
AI_DOCS_FASTEMBED__CACHE_DIR=./cache/fastembed
AI_DOCS_EMBEDDING__RETRIEVAL_MODE=dense
AI_DOCS_CHUNKING__STRATEGY=enhanced
AI_DOCS_CHUNKING__CHUNK_SIZE=1600
AI_DOCS_CHUNKING__CHUNK_OVERLAP=200
AI_DOCS_HYDE__ENABLE_HYDE=false
AI_DOCS_RAG__ENABLE_RAG=false
AI_DOCS_RERANKING__ENABLED=false

# Runtime limits
AI_DOCS_PERFORMANCE__MAX_CONCURRENT_CRAWLS=10
AI_DOCS_PERFORMANCE__MAX_CONCURRENT_EMBEDDINGS=32
AI_DOCS_PERFORMANCE__REQUEST_TIMEOUT=30
AI_DOCS_PERFORMANCE__MAX_MEMORY_USAGE_MB=1000

# Optional operations
AI_DOCS_MONITORING__ENABLED=false
AI_DOCS_OBSERVABILITY__ENABLED=false
AI_DOCS_SECURITY__API_KEY_REQUIRED=false
AI_DOCS_SECURITY__ENABLE_RATE_LIMITING=true
